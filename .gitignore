# scout-workbench/ is a per-project runtime artifact created in user projects,
# not in this plugin source tree. If it ever appears here (e.g. during dev
# testing), it should not be committed.
scout-workbench/
fusion-workbench/

# Internal build notes — kept inside the working tree but out of the public repo.
# fusion writes its activity log as activity-log-<checkout>.md in the project
# root (the retired name was activity-log-kai.md); root-anchored so it cannot
# hide a same-named file elsewhere in the plugin tree.
CLAUDE.md
/activity-log-*.md

# IDE / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Python artifacts (the browser-use Anthropic shim)
__pycache__/
*.pyc
